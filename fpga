<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lab FPGA PNJ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: meja lab — kolom tunggal 1080px, navigasi lengket, kalkulator sebagai panel instrumen dua kolom (masukan | hasil) */
:root{
  --bg:#EDF0F3; --surface:#FFFFFF; --sunk:#F5F7F9; --ink:#14202B; --muted:#56636F; --line:#D2D9E0;
  --led:#D7263D; --led-soft:#FBE7EA; --signal:#0E7A8A; --signal-soft:#E2F2F4; --warn:#B26A00; --warn-soft:#FFF3DF; --ok:#1F7A4A; --ok-soft:#E3F3EA;
  --panel:#11161B; --panel-ink:#C9D3DC; --seg-on:#FF3B3B; --seg-off:#2A1C1F; --code-bg:#11161B; --code-ink:#DCE4EA; --code-kw:#FF8A80; --code-cm:#7F8C97; --code-num:#F2C46D;
  --f-display:"Barlow Condensed","Arial Narrow",Arial,sans-serif; --f-body:"IBM Plex Sans","Segoe UI",Roboto,Arial,sans-serif; --f-mono:"JetBrains Mono",Consolas,"Courier New",monospace;
  --r:6px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0E1317; --surface:#161E25; --sunk:#121920; --ink:#E2E8ED; --muted:#93A1AD; --line:#2A3540;
  --led:#FF5A64; --led-soft:#3A1E23; --signal:#3FB8C9; --signal-soft:#16313A; --warn:#F0B44C; --warn-soft:#3A2D14; --ok:#5CCB8C; --ok-soft:#163323;
  --panel:#0A0E11; --panel-ink:#AEB9C3; --seg-on:#FF4D4D; --seg-off:#22171A; --code-bg:#0A0E11; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E1317; --surface:#161E25; --sunk:#121920; --ink:#E2E8ED; --muted:#93A1AD; --line:#2A3540;
  --led:#FF5A64; --led-soft:#3A1E23; --signal:#3FB8C9; --signal-soft:#16313A; --warn:#F0B44C; --warn-soft:#3A2D14; --ok:#5CCB8C; --ok-soft:#163323;
  --panel:#0A0E11; --panel-ink:#AEB9C3; --seg-on:#FF4D4D; --seg-off:#22171A; --code-bg:#0A0E11; color-scheme:dark}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.55;margin:0}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
.wrap{max-width:1080px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--f-display);font-weight:700;letter-spacing:.01em;text-wrap:balance;margin:0}
h2{font-size:2rem;line-height:1.1}
h3{font-size:1.3rem;font-weight:600}
p{margin:0}
code,.mono{font-family:var(--f-mono);font-size:.88em}
.eyebrow{font-family:var(--f-display);font-weight:600;font-size:.95rem;letter-spacing:.14em;text-transform:uppercase;color:var(--signal)}
a{color:var(--signal)}
:focus-visible{outline:2px solid var(--signal);outline-offset:2px}

/* nav */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--surface);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;gap:20px;min-height:52px;overflow-x:auto;scrollbar-width:none}
.nav .wrap::-webkit-scrollbar{display:none}
.brand{font-family:var(--f-display);font-weight:700;font-size:1.15rem;white-space:nowrap;display:flex;align-items:center;gap:8px}
.brand i{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--led);box-shadow:0 0 8px var(--led)}
.nav a{color:var(--muted);text-decoration:none;font-weight:500;white-space:nowrap;font-size:.93rem}
.nav a:hover{color:var(--ink)}

/* hero */
.hero{padding-block:40px 28px}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:center}
.hero h1{font-size:clamp(2.3rem,5vw,3.4rem);line-height:1.02;margin-top:8px}
.hero .lead{color:var(--muted);margin-top:14px;max-width:56ch}
.facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chip{font-family:var(--f-mono);font-size:.78rem;padding:4px 9px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--muted);white-space:nowrap}
.scope{background:var(--panel);border-radius:10px;padding:22px 22px 16px;color:var(--panel-ink)}
.scope svg{width:100%;height:auto;display:block}
.scope .cap{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-family:var(--f-mono);font-size:.74rem;margin-top:12px;color:var(--panel-ink)}
.scope .cap b{color:var(--seg-on);font-weight:600}

section{padding-block:36px}
.sec-head{display:flex;flex-direction:column;gap:6px;margin-bottom:20px}
.sec-head p{color:var(--muted);max-width:68ch}

/* calculator */
.fclk{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 16px;margin-bottom:14px}
.fclk label{font-weight:600}
.tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:-1px;position:relative}
.tab{font:inherit;font-weight:600;font-size:.92rem;padding:9px 14px;border:1px solid var(--line);border-bottom:none;background:var(--sunk);color:var(--muted);border-radius:var(--r) var(--r) 0 0;cursor:pointer}
.tab[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:inset 0 3px 0 var(--led)}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:0 var(--r) var(--r) var(--r);padding:20px}
.calc{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:24px}
.inputs{display:flex;flex-direction:column;gap:14px}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-weight:600;font-size:.9rem}
.field small{color:var(--muted);font-size:.8rem}
.row{display:flex;gap:8px}
input[type=number],select{font:inherit;font-family:var(--f-mono);font-size:.95rem;padding:8px 10px;border:1px solid var(--line);border-radius:var(--r);background:var(--sunk);color:var(--ink);min-width:0;width:100%}
select{width:auto;min-width:76px}
.seg-ctl{display:inline-flex;border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.seg-ctl button{font:inherit;font-size:.85rem;padding:6px 12px;border:none;background:var(--sunk);color:var(--muted);cursor:pointer}
.seg-ctl button[aria-pressed="true"]{background:var(--ink);color:var(--surface)}
.presets{display:flex;flex-wrap:wrap;gap:6px}
.presets button{font:inherit;font-size:.78rem;padding:4px 9px;border:1px dashed var(--line);border-radius:999px;background:transparent;color:var(--muted);cursor:pointer}
.presets button:hover{color:var(--ink);border-style:solid}
.formula{font-family:var(--f-mono);font-size:.85rem;background:var(--sunk);border-radius:var(--r);padding:10px 12px;color:var(--ink)}
.results{display:flex;flex-direction:column;gap:12px;min-width:0}
.big{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.big .lab{font-family:var(--f-display);font-weight:600;font-size:1.05rem;color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
.big .val{font-family:var(--f-mono);font-weight:600;font-size:clamp(1.6rem,3.6vw,2.3rem);color:var(--led);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}
.kv div{background:var(--sunk);border-radius:var(--r);padding:8px 10px;min-width:0}
.kv span{display:block;font-size:.76rem;color:var(--muted)}
.kv b{font-family:var(--f-mono);font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.status{font-size:.86rem;padding:8px 12px;border-radius:var(--r);border-left:3px solid}
.status.ok{background:var(--ok-soft);border-color:var(--ok);color:var(--ink)}
.status.warn{background:var(--warn-soft);border-color:var(--warn);color:var(--ink)}
.status.bad{background:var(--led-soft);border-color:var(--led);color:var(--ink)}
.code{position:relative;background:var(--code-bg);color:var(--code-ink);border-radius:var(--r);padding:12px 14px;overflow-x:auto}
.code pre{margin:0;padding-right:62px;font-family:var(--f-mono);font-size:.82rem;line-height:1.55;white-space:pre}
.code .kw{color:var(--code-kw);font-weight:600}.code .cm{color:var(--code-cm);font-style:italic}.code .nm{color:var(--code-num)}
.copy{position:absolute;top:8px;right:8px;font:inherit;font-size:.74rem;padding:3px 9px;border:1px solid #3A4651;border-radius:4px;background:#1C242B;color:#C9D3DC;cursor:pointer}
.copy:hover{background:#26313A}
.diagram{background:var(--sunk);border-radius:var(--r);padding:10px 8px 6px;overflow-x:auto}
.diagram svg{display:block;min-width:460px;width:100%;height:auto}
.diagram small{display:block;color:var(--muted);font-size:.76rem;padding:2px 6px 0}

/* weeks */
.weeks{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.wk{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;display:flex;flex-direction:column;gap:6px;min-width:0}
.wk .top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.wk .no{font-family:var(--f-display);font-weight:700;font-size:1.5rem;line-height:1}
.tag{font-size:.7rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;border-radius:4px}
.tag.sch{background:var(--signal-soft);color:var(--signal)}
.tag.v{background:var(--led-soft);color:var(--led)}
.tag.ex{background:var(--sunk);color:var(--muted);border:1px solid var(--line)}
.wk p{font-size:.88rem}
.wk .mods{display:flex;flex-wrap:wrap;gap:4px}
.wk .mods code{font-size:.72rem;background:var(--sunk);padding:1px 6px;border-radius:3px;color:var(--muted)}
.wk.exam{background:var(--sunk)}

/* board */
.board{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:18px;align-items:start}
.tbl{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
table{border-collapse:collapse;width:100%;font-size:.88rem}
th,td{text-align:left;padding:8px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--f-display);font-weight:600;letter-spacing:.05em;text-transform:uppercase;font-size:.85rem;color:var(--muted);background:var(--sunk)}
tr:last-child td{border-bottom:none}
td.pin{font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
.pol{font-size:.8rem;font-weight:600;white-space:nowrap}
.pol.low{color:var(--led)}.pol.note{color:var(--warn)}
.notes{display:flex;flex-direction:column;gap:10px}
.note{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px}
.note h3{font-size:1.08rem;margin-bottom:4px}
.note p{font-size:.88rem;color:var(--muted)}
.note.alert{border-color:var(--led)}
.note.alert h3{color:var(--led)}

/* modules */
.mods-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px}
.mod-list{display:flex;flex-direction:column;gap:6px}
.mod-list button{font:inherit;text-align:left;padding:10px 12px;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);color:var(--ink);cursor:pointer;display:flex;flex-direction:column;gap:2px}
.mod-list button b{font-family:var(--f-mono);font-size:.88rem}
.mod-list button span{font-size:.78rem;color:var(--muted)}
.mod-list button[aria-selected="true"]{border-color:var(--led);box-shadow:inset 3px 0 0 var(--led)}
.mod-view{display:flex;flex-direction:column;gap:10px;min-width:0}
.mod-view p{color:var(--muted);font-size:.9rem}

/* rules */
.rules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.rule{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:6px}
.rule .pair{font-family:var(--f-mono);font-size:.88rem;color:var(--led);font-weight:600}
.rule p{font-size:.88rem;color:var(--muted)}

footer{padding-block:28px 40px;color:var(--muted);font-size:.84rem;border-top:1px solid var(--line);margin-top:20px}
footer .wrap{display:flex;flex-direction:column;gap:6px}

@media (max-width:860px){
  .hero .wrap,.calc,.board,.mods-grid{grid-template-columns:minmax(0,1fr)}
  .weeks{grid-template-columns:repeat(2,minmax(0,1fr))}
  .rules{grid-template-columns:minmax(0,1fr)}
  .mod-list{flex-direction:row;flex-wrap:wrap}
  .mod-list button{flex:1 1 140px}
}
@media (max-width:460px){.weeks{grid-template-columns:minmax(0,1fr)}h2{font-size:1.7rem}}
</style>
</head>
<body>


<nav class="nav" aria-label="Navigasi">
  <div class="wrap">
    <span class="brand"><i aria-hidden="true"></i>Lab FPGA</span>
    <a href="#kalkulator">Kalkulator clock</a>
    <a href="#peta">Peta 16 minggu</a>
    <a href="#board">Board &amp; pin</a>
    <a href="#modul">Modul inti</a>
    <a href="#aturan">Aturan emas</a>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow">D4 Instrumentasi dan Kontrol Industri · PNJ</div>
      <h1>Praktik Elektronika Digital berbasis PLD dan FPGA</h1>
      <p class="lead">Pegangan praktikum: hitung nilai N untuk tick, pembagi frekuensi, pemindaian display, dan tachometer; cek pin board; dan salin modul Verilog yang dipakai dari Minggu 9 sampai proyek akhir.</p>
      <div class="facts">
        <span class="chip">EP4CE6E22C8 · Cyclone IV E</span>
        <span class="chip">clk 50 MHz · pin 23</span>
        <span class="chip">Quartus Prime · Verilog</span>
      </div>
    </div>
    <div class="scope" aria-label="Contoh display 7-segment menghitung detik">
      <svg id="heroSeg" viewBox="0 0 400 150" role="img" aria-label="Display menghitung menit dan detik"></svg>
      <div class="cap"><span>tick_gen #(.N(<b>50_000_000</b>)) → 1 Hz</span><span>display4 · 1 ms/digit</span></div>
    </div>
  </div>
</header>

<main>
<section id="kalkulator">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">Alat</div>
      <h2>Kalkulator clock</h2>
      <p>Masukkan kebutuhan waktu atau frekuensi; nilai N, lebar counter, dan baris instansiasi Verilog langsung muncul. Semua perhitungan memakai satu clock dengan enable, sesuai gaya rancangan di mata kuliah ini.</p>
    </div>
    <div class="fclk">
      <label for="fclk">Frekuensi clock</label>
      <div class="row" style="max-width:220px"><input id="fclk" type="number" min="0.001" step="any" value="50"><select id="fclkU" aria-label="Satuan clock"><option value="1e6" selected>MHz</option><option value="1e3">kHz</option></select></div>
      <span class="chip">osilator board OurFPGA = 50 MHz</span>
    </div>
    <div class="tabs" role="tablist" aria-label="Jenis perhitungan">
      <button class="tab" role="tab" id="t-tick" aria-controls="p-tick" aria-selected="true">Tick / enable</button>
      <button class="tab" role="tab" id="t-sq" aria-controls="p-sq" aria-selected="false">Gelombang kotak</button>
      <button class="tab" role="tab" id="t-scan" aria-controls="p-scan" aria-selected="false">Pindai display</button>
      <button class="tab" role="tab" id="t-mod" aria-controls="p-mod" aria-selected="false">Counter mod-N</button>
      <button class="tab" role="tab" id="t-tacho" aria-controls="p-tacho" aria-selected="false">Tachometer</button>
    </div>

    <!-- TICK -->
    <div class="panel" role="tabpanel" id="p-tick" aria-labelledby="t-tick">
      <div class="calc">
        <div class="inputs">
          <div class="field">
            <label>Masukan</label>
            <div class="seg-ctl" id="tickMode"><button type="button" data-m="t" aria-pressed="true">Periode tick</button><button type="button" data-m="f" aria-pressed="false">Frekuensi tick</button></div>
          </div>
          <div class="field">
            <label for="tickVal" id="tickLab">Selang antartick</label>
            <div class="row"><input id="tickVal" type="number" min="0" step="any" value="1"><select id="tickU" aria-label="Satuan"></select></div>
          </div>
          <div class="field"><label>Contoh</label>
            <div class="presets" id="tickPre">
              <button type="button" data-v="1" data-u="1" data-m="t">1 s (detik)</button>
              <button type="button" data-v="250" data-u="1e-3" data-m="t">0,25 s (LED berjalan)</button>
              <button type="button" data-v="1" data-u="1e-3" data-m="t">1 ms (pindai)</button>
              <button type="button" data-v="1" data-u="1e3" data-m="f">1 kHz (sampel)</button>
            </div>
          </div>
          <div class="formula">N = f<sub>clk</sub> × t = f<sub>clk</sub> / f<sub>tick</sub><br>bit = $clog2(N)</div>
        </div>
        <div class="results">
          <div class="big"><span class="lab">N</span><span class="val" id="tickN">–</span></div>
          <div class="kv">
            <div><span>Lebar counter</span><b id="tickBits">–</b></div>
            <div><span>Rentang cnt</span><b id="tickRange">–</b></div>
            <div><span>f tick sebenarnya</span><b id="tickF">–</b></div>
            <div><span>Lebar pulsa tick</span><b id="tickW">–</b></div>
          </div>
          <div class="status" id="tickStat"></div>
          <div class="code"><button class="copy" type="button" data-copy="tickCode">Salin</button><pre id="tickCode"></pre></div>
          <div class="diagram"><svg id="tickSvg" viewBox="0 0 560 150"></svg><small id="tickNote"></small></div>
        </div>
      </div>
    </div>

    <!-- SQUARE -->
    <div class="panel" role="tabpanel" id="p-sq" aria-labelledby="t-sq" hidden>
      <div class="calc">
        <div class="inputs">
          <div class="field">
            <label for="sqVal">Frekuensi keluaran</label>
            <div class="row"><input id="sqVal" type="number" min="0" step="any" value="2"><select id="sqU" aria-label="Satuan"><option value="1">Hz</option><option value="1e3" selected>kHz</option><option value="1e6">MHz</option></select></div>
            <small>Untuk LED berkedip atau nada buzzer (speaker pasif di pin 110 butuh sinyal nada).</small>
          </div>
          <div class="field"><label>Contoh</label>
            <div class="presets" id="sqPre">
              <button type="button" data-v="0.5" data-u="1">0,5 Hz (LED 1 s nyala/1 s padam)</button>
              <button type="button" data-v="2" data-u="1">2 Hz (kedip cepat)</button>
              <button type="button" data-v="1" data-u="1e3">1 kHz (nada)</button>
              <button type="button" data-v="2" data-u="1e3">2 kHz (nada alarm)</button>
            </div>
          </div>
          <div class="formula">N = f<sub>clk</sub> / (2 · f<sub>out</sub>)<br>keluaran dibalik setiap tick → 1 periode = 2 tick</div>
        </div>
        <div class="results">
          <div class="big"><span class="lab">N</span><span class="val" id="sqN">–</span></div>
          <div class="kv">
            <div><span>Lebar counter</span><b id="sqBits">–</b></div>
            <div><span>f keluaran sebenarnya</span><b id="sqF">–</b></div>
            <div><span>Periode keluaran</span><b id="sqT">–</b></div>
            <div><span>Waktu tinggi = rendah</span><b id="sqH">–</b></div>
          </div>
          <div class="status" id="sqStat"></div>
          <div class="code"><button class="copy" type="button" data-copy="sqCode">Salin</button><pre id="sqCode"></pre></div>
          <div class="diagram"><svg id="sqSvg" viewBox="0 0 560 150"></svg><small id="sqNote"></small></div>
        </div>
      </div>
    </div>

    <!-- SCAN -->
    <div class="panel" role="tabpanel" id="p-scan" aria-labelledby="t-scan" hidden>
      <div class="calc">
        <div class="inputs">
          <div class="field">
            <label for="scanVal">Giliran per digit</label>
            <div class="row"><input id="scanVal" type="number" min="0" step="any" value="1"><select id="scanU" aria-label="Satuan"><option value="1e-6">µs</option><option value="1e-3" selected>ms</option></select></div>
          </div>
          <div class="field">
            <label for="scanD">Jumlah digit</label>
            <input id="scanD" type="number" min="1" max="8" step="1" value="4">
            <small>Board OurFPGA: 4 digit, DIG1 paling kiri … DIG4 paling kanan.</small>
          </div>
          <div class="field"><label>Contoh</label>
            <div class="presets" id="scanPre">
              <button type="button" data-v="1" data-u="1e-3">1 ms (anjuran)</button>
              <button type="button" data-v="2" data-u="1e-3">2 ms</button>
              <button type="button" data-v="100" data-u="1e-3">100 ms (lihat giliran)</button>
            </div>
          </div>
          <div class="formula">N_SCAN = f<sub>clk</sub> × t<sub>digit</sub><br>putaran per detik = 1 / (jumlah digit × t<sub>digit</sub>)</div>
