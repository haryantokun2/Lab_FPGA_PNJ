function drawTiming(svgId, N, square){
  const svg = $(svgId); const steps = square ? 4 * N + 2 : 2 * N + 4; const cycles = Math.ceil(steps / 1);
  const nC = square ? Math.min(2 * N + 2, 22) : Math.min(N * 2 + 2, 22);
  const x0 = 78, W = 560 - x0 - 8, step = W / (nC * 2);
  const ink = css("--ink"), mut = css("--muted"), led = css("--led"), sig = css("--signal"), line = css("--line");
