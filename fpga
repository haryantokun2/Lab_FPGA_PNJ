const MODS = [{"name": "seg7_dec", "week": "Minggu 10", "desc": "Decoder heksadesimal ke 7-segment, ditulis aktif high (1 = segmen menyala). Pembalikan untuk display common anode dilakukan sekali di modul top atau di display4.", "src": "// Ditulis aktif high; polaritas display ditangani di top-level.\nmodule seg7_dec (\n    input      [3:0] bin,\n    output reg [6:0] seg     // {g,f,e,d,c,b,a}, 1 = segmen menyala\n);\n    always @(*) begin\n        case (bin)\n            4'h0: seg = 7'b0111111;   4'h8: seg = 7'b1111111;\n            4'h1: seg = 7'b0000110;   4'h9: seg = 7'b1101111;\n            4'h2: seg = 7'b1011011;   4'hA: seg = 7'b1110111;\n            4'h3: seg = 7'b1001111;   4'hB: seg = 7'b1111100;\n            4'h4: seg = 7'b1100110;   4'hC: seg = 7'b0111001;\n            4'h5: seg = 7'b1101101;   4'hD: seg = 7'b1011110;\n            4'h6: seg = 7'b1111101;   4'hE: seg = 7'b1111001;\n            4'h7: seg = 7'b0000111;   4'hF: seg = 7'b1110001;\n            default: seg = 7'b0000000;\n        endcase\n    end\nendmodule"}, {"name": "tick_gen", "week": "Minggu 11–12", "desc": "Pembangkit pulsa tick selebar satu clock setiap N clock. Dipakai sebagai enable, bukan sebagai clock. Hitung N dengan kalkulator Tick / enable.", "src": "// Keluaran tick = 1 selama SATU periode clock, setiap N clock.\n// f_tick = f_clk / N ; lebar counter dihitung otomatis dengan $clog2(N)\nmodule tick_gen #(parameter N = 50_000_000) (\n    input  clk, rst,\n    output tick\n);\n    reg [$clog2(N)-1:0] cnt;\n\n    assign tick = (cnt == N - 1);\n\n    always @(posedge clk) begin\n        if (rst || tick) cnt <= 0;\n        else             cnt <= cnt + 1'b1;\n    end\nendmodule"}, {"name": "counter_n", "week": "Minggu 12", "desc": "Counter modulo-N berparameter dengan terminal count. Rangkaikan tc ke en counter berikutnya untuk counter bertingkat (detik, menit, jam).", "src": "// Menghitung 0 .. N-1 lalu kembali ke 0. tc = 1 saat q = N-1 DAN en = 1,\n// sehingga aman dipakai sebagai enable counter tingkat berikutnya.\nmodule counter_n #(parameter N = 10) (\n    input                      clk, rst, en,\n    output reg [$clog2(N)-1:0] q,\n    output                     tc\n);\n    assign tc = en && (q == N - 1);\n\n    always @(posedge clk) begin\n        if (rst)     q <= 0;\n        else if (en) q <= (q == N - 1) ? 0 : q + 1'b1;\n    end\nendmodule"}, {"name": "clk_div_sq", "week": "Minggu 12", "desc": "Pembangkit gelombang kotak duty 50 %: keluaran dibalik setiap tick. Untuk LED berkedip dan nada buzzer. Hitung N dengan kalkulator Gelombang kotak.", "src": "// f_out = f_clk / (2 x N)\nmodule clk_div_sq #(parameter N = 50_000_000) (\n    input      clk, rst,\n    output reg out\n);\n    wire t;\n\n    tick_gen #(.N(N)) u_t (.clk(clk), .rst(rst), .tick(t));\n\n    always @(posedge clk)\n        if (rst)    out <= 1'b0;\n        else if (t) out <= ~out;\nendmodule"}, {"name": "display4", "week": "Minggu 12", "desc": "Pengendali display multipleks empat digit. d0 tampil di digit yang tersambung ke dig[0]; pasang dig[0] ke DIG4 (pin 137) agar d0 tampil paling kanan.", "src": "// Setiap digit mendapat giliran 1 ms (50 MHz / 50.000), seluruh display\n// diperbarui 250 kali per detik sehingga keempat digit tampak menyala bersama.\nmodule display4 #(parameter N_SCAN = 50_000) (\n    input            clk, rst,\n    input      [3:0] d0, d1, d2, d3,   // nilai tiap digit (d0 = DIG1)\n    output     [6:0] seg,              // segmen {g..a}, aktif low (common anode)\n    output reg [3:0] dig               // pemilih digit, aktif low (PNP)\n);\n    wire       t;\n    reg  [1:0] pilih;\n    reg  [3:0] nilai;\n    wire [6:0] seg_h;\n\n    tick_gen #(.N(N_SCAN)) u_scan (.clk(clk), .rst(rst), .tick(t));\n\n    always @(posedge clk)\n        if (rst)    pilih <= 2'd0;\n        else if (t) pilih <= pilih + 2'd1;\n\n    always @(*) begin\n        case (pilih)\n            2'd0:    begin nilai = d0; dig = 4'b1110; end\n            2'd1:    begin nilai = d1; dig = 4'b1101; end\n            2'd2:    begin nilai = d2; dig = 4'b1011; end\n            default: begin nilai = d3; dig = 4'b0111; end\n        endcase\n    end\n\n    seg7_dec u_dec (.bin(nilai), .seg(seg_h));   // dari M10\n    assign seg = ~seg_h;                         // hapus ~ bila common cathode\nendmodule"}];
