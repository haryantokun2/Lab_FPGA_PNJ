  const wave = (bits, y, col) => { let d = ""; let prev = null; for (let i = 0; i < bits.length; i++) { const yy = bits[i] ? y : y + 18; const x = x0 + i * step; if (prev !== null && prev !== yy) d += `L${x},${yy}`; else if (prev === null) d += `M${x},${yy}`; d += `L${x + step},${yy}`; prev = yy; } return `<path d="${d}" fill="none" stroke="${col}" stroke-width="1.8"/>`; };
  for (let k = 0; k <= nC; k++) g += `<line x1="${x0 + 2 * k * step}" y1="6" x2="${x0 + 2 * k * step}" y2="146" stroke="${line}" stroke-width="1" stroke-dasharray="2 3"/>`;
  const clk = []; for (let k = 0; k < nC; k++) clk.push(1, 0);
  g += lab("clk", 8) + wave(clk, 8, mut);
  // cnt bus
  g += lab("cnt", 44);
  for (let k = 0; k < nC; k++) { const x = x0 + 2 * k * step, w = 2 * step; g += `<rect x="${x}" y="44" width="${w}" height="18" fill="none" stroke="${sig}" stroke-width="1.2"/>`; if (w > 14) g += `<text x="${x + w / 2}" y="57" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="${w > 26 ? 10 : 8}" fill="${ink}">${k % N}</text>`; }
  const tick = []; for (let k = 0; k < nC; k++) { const v = k % N === N - 1 ? 1 : 0; tick.push(v, v); }
  g += lab("tick", 80) + wave(tick, 80, led);
  if (square) { const out = []; let o = 0; for (let k = 0; k < nC; k++) { out.push(o, o); if (k % N === N - 1) o ^= 1; } g += lab("out", 116) + wave(out, 116, sig); }
  svg.setAttribute("viewBox", `0 0 560 ${square ? 150 : 112}`);
  svg.innerHTML = g;
}

// ---------- TICK ----------
let tickMode = "t";
function tickUnits(){ const s = $("tickU"); s.innerHTML = tickMode === "t" ? '<option value="1e-6">µs</option><option value="1e-3">ms</option><option value="1" selected>s</option>' : '<option value="1" selected>Hz</option><option value="1e3">kHz</option><option value="1e6">MHz</option>'; $("tickLab").textContent = tickMode === "t" ? "Selang antartick" : "Frekuensi tick"; }
function calcTick(){
  const f = fclk(); const v = parseFloat($("tickVal").value) * parseFloat($("tickU").value);
  const t = tickMode === "t" ? v : 1 / v; const Nx = f * t; const N = Math.round(Nx);
  if (!(N >= 2) || !isFinite(N)) { $("tickN").textContent = "–"; ["tickBits","tickRange","tickF","tickW"].forEach((i) => $(i).textContent = "–"); status("tickStat","bad","N harus minimal 2. Perbesar selang tick atau periksa frekuensi clock."); setCode("tickCode","// N tidak sah"); $("tickSvg").innerHTML=""; $("tickNote").textContent=""; return; }
  const fa = f / N, err = (fa - 1 / t) / (1 / t) * 100;
  $("tickN").textContent = nf(N); $("tickBits").textContent = clog2(N) + " bit"; $("tickRange").textContent = "0 – " + nf(N - 1);
  $("tickF").textContent = fmtF(fa); $("tickW").textContent = fmtT(1 / f) + " (1 clock)";
  if (Math.abs(Nx - N) > 1e-6) status("tickStat","warn",`N sebenarnya ${nf(Nx,3)} dibulatkan ke ${nf(N)}; frekuensi tick meleset ${nf(err,4)} %.`);
  else status("tickStat","ok",`N bulat, frekuensi tepat. Tick selebar 1 clock tidak terlihat bila dipasang ke LED; pakai sebagai enable.`);
  setCode("tickCode", `tick_gen #(.N(${und(N)})) u_tick (.clk(clk), .rst(rst), .tick(tick));\n// f_tick = ${fmtF(fa)}  |  cnt ${clog2(N)} bit`);
  const Nv = Math.min(N, 6); drawTiming("tickSvg", Nv, false);
  $("tickNote").textContent = N > 6 ? `Diagram digambar untuk N = ${Nv} agar terbaca; pola sama untuk N = ${nf(N)}.` : `Diagram untuk N = ${N}.`;
}
// ---------- SQUARE ----------
function calcSq(){
  const f = fclk(); const fo = parseFloat($("sqVal").value) * parseFloat($("sqU").value);
  const Nx = f / (2 * fo), N = Math.round(Nx);
  if (!(N >= 2) || !isFinite(N)) { $("sqN").textContent = "–"; ["sqBits","sqF","sqT","sqH"].forEach((i) => $(i).textContent = "–"); status("sqStat","bad","N harus minimal 2: frekuensi keluaran maksimum adalah f_clk / 4."); setCode("sqCode","// N tidak sah"); $("sqSvg").innerHTML=""; $("sqNote").textContent=""; return; }
  const fa = f / (2 * N), err = (fa - fo) / fo * 100;
  $("sqN").textContent = nf(N); $("sqBits").textContent = clog2(N) + " bit"; $("sqF").textContent = fmtF(fa); $("sqT").textContent = fmtT(1 / fa); $("sqH").textContent = fmtT(N / f);
  if (Math.abs(Nx - N) > 1e-6) status("sqStat","warn",`N sebenarnya ${nf(Nx,3)} dibulatkan ke ${nf(N)}; frekuensi meleset ${nf(err,4)} %.`);
  else status("sqStat","ok","N bulat, frekuensi tepat, duty cycle 50 %. Lupa faktor 2 membuat frekuensi menjadi setengahnya.");
  setCode("sqCode", `clk_div_sq #(.N(${und(N)})) u_div (.clk(clk), .rst(rst), .out(out));\n// f_out = ${fmtF(fa)}  |  periode ${fmtT(1 / fa)}`);
  const Nv = Math.min(N, 4); drawTiming("sqSvg", Nv, true);
  $("sqNote").textContent = N > 4 ? `Diagram digambar untuk N = ${Nv}; keluaran berbalik setiap tick untuk N = ${nf(N)}.` : `Diagram untuk N = ${N}.`;
}
// ---------- SCAN ----------
function calcScan(){
  const f = fclk(); const t = parseFloat($("scanVal").value) * parseFloat($("scanU").value); const D = Math.max(1, Math.round(parseFloat($("scanD").value) || 4));
  const N = Math.round(f * t);
  if (!(N >= 2) || !isFinite(N)) { $("scanN").textContent = "–"; ["scanBits","scanT","scanR","scanDuty"].forEach((i) => $(i).textContent = "–"); status("scanStat","bad","N_SCAN harus minimal 2."); setCode("scanCode","// N_SCAN tidak sah"); return; }
  const tr = D * N / f, rate = 1 / tr;
  $("scanN").textContent = nf(N); $("scanBits").textContent = clog2(N) + " bit"; $("scanT").textContent = fmtT(tr); $("scanR").textContent = nf(rate, 1) + " kali"; $("scanDuty").textContent = nf(100 / D, 1) + " %";
  if (rate < 50) status("scanStat","bad",`Hanya ${nf(rate,1)} putaran per detik: tampilan akan berkedip atau terlihat bergantian. Perkecil giliran per digit.`);
  else if (rate < 100) status("scanStat","warn",`${nf(rate,1)} putaran per detik: masih bisa tampak berkedip, terutama dilihat sambil bergerak. Disarankan di atas 100.`);
  else if (N / f < 50e-6) status("scanStat","warn","Giliran sangat singkat: segmen digit tetangga bisa tampak samar (ghosting) karena transistor belum sempat mati.");
  else status("scanStat","ok",`${nf(rate,0)} putaran per detik: keempat digit tampak menyala bersamaan.`);
  setCode("scanCode", `display4 #(.N_SCAN(${und(N)})) u_disp (\n    .clk(clk), .rst(rst),\n    .d0(satuan), .d1(puluhan), .d2(4'd0), .d3(4'd0),\n    .seg(seg), .dig(dig));`);
}
// ---------- MOD N ----------
function calcMod(){
  const N = Math.round(parseFloat($("modN").value)); const T = parseFloat($("modT").value) * parseFloat($("modTU").value);
  if (!(N >= 2)) { ["modBits","modRange","modUnused","modCycle","modTc"].forEach((i) => $(i).textContent = "–"); setCode("modCode","// N minimal 2"); return; }
  const b = clog2(N);
  $("modBits").textContent = b + " bit"; $("modRange").textContent = "0 – " + nf(N - 1); $("modUnused").textContent = nf(2 ** b - N);
  $("modCycle").textContent = T > 0 ? fmtT(N * T) : "–"; $("modTc").textContent = T > 0 ? fmtF(1 / (N * T)) : "–";
  setCode("modCode", `counter_n #(.N(${und(N)})) u_cnt (\n    .clk(clk), .rst(rst), .en(tick),\n    .q(q),          // reg [${b - 1}:0]\n    .tc(tc));       // en && (q == ${N - 1})`);
}
// ---------- TACHO ----------
function calcTacho(){
  const f = fclk(); const Tg = parseFloat($("tgVal").value) * parseFloat($("tgU").value); const ppr = Math.max(1, Math.round(parseFloat($("ppr").value) || 1)); const dg = Math.max(1, Math.round(parseFloat($("tdig").value) || 4));
  const N = Math.round(f * Tg);
  if (!(N >= 2) || !isFinite(N)) { ["tgN","tgBits","tgRes","tgRpmRes","tgUpd","tgFmax","tgRpmMax"].forEach((i) => $(i).textContent = "–"); status("tgStat","bad","Waktu gerbang terlalu singkat."); setCode("tgCode","// N_GATE tidak sah"); return; }
  const maxCnt = 10 ** dg - 1, fmax = maxCnt / Tg, res = 1 / Tg, rpmRes = 60 / (ppr * Tg);
  $("tgN").textContent = nf(N); $("tgBits").textContent = clog2(N) + " bit"; $("tgRes").textContent = fmtF(res); $("tgRpmRes").textContent = nf(rpmRes, 3) + " RPM";
  $("tgUpd").textContent = nf(1 / Tg, 3) + " kali/s"; $("tgFmax").textContent = fmtF(fmax); $("tgRpmMax").textContent = nf(fmax * 60 / ppr, 1) + " RPM";
  const direct = 60 / ppr;
  if (Math.abs(Tg - 1) < 1e-9) status("tgStat","ok",`Dengan gerbang 1 s, angka di display langsung bernilai Hz. Untuk RPM, kalikan 60/PPR = ${nf(direct,3)}, atau pakai gerbang ${fmtT(direct)} agar display langsung menunjukkan RPM.`);
  else status("tgStat","warn",`Hitungan di display harus dikalikan ${nf(1 / Tg,3)} untuk mendapat Hz. Gerbang yang lebih panjang memperhalus resolusi tetapi memperlambat pembaruan.`);
  setCode("tgCode", `freq_meter #(.N_GATE(${und(N)})) u_fm (...);\n// T_gate = ${fmtT(Tg)}  |  resolusi ${fmtF(res)}  |  ${nf(rpmRes,3)} RPM (PPR ${ppr})`);
}

function calcAll(){ calcTick(); calcSq(); calcScan(); calcMod(); calcTacho(); }

// ---------- tabs ----------
const tabs = [...document.querySelectorAll(".tab")];
function selectTab(btn){ tabs.forEach((b) => { const on = b === btn; b.setAttribute("aria-selected", on); $(b.getAttribute("aria-controls")).hidden = !on; }); try { localStorage.setItem("fpga-tab", btn.id); } catch (e) {} }
tabs.forEach((b) => b.addEventListener("click", () => selectTab(b)));
tabs.forEach((b, i) => b.addEventListener("keydown", (e) => { if (e.key === "ArrowRight" || e.key === "ArrowLeft") { const n = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length]; n.focus(); selectTab(n); } }));
try { const s = localStorage.getItem("fpga-tab"); if (s && $(s)) selectTab($(s)); } catch (e) {}

document.querySelectorAll("#tickMode button").forEach((b) => b.addEventListener("click", () => { tickMode = b.dataset.m; document.querySelectorAll("#tickMode button").forEach((x) => x.setAttribute("aria-pressed", x === b)); tickUnits(); $("tickVal").value = tickMode === "t" ? 1 : 1; calcTick(); }));
function preset(container, apply){ document.querySelectorAll(container + " button").forEach((b) => b.addEventListener("click", () => { apply(b.dataset); calcAll(); })); }
preset("#tickPre", (d) => { if (d.m !== tickMode) document.querySelector(`#tickMode button[data-m="${d.m}"]`).click(); $("tickVal").value = d.v; $("tickU").value = d.u; });
preset("#sqPre", (d) => { $("sqVal").value = d.v; $("sqU").value = d.u; });
preset("#scanPre", (d) => { $("scanVal").value = d.v; $("scanU").value = d.u; });
preset("#modPre", (d) => { $("modN").value = d.v; });
document.querySelectorAll("input,select").forEach((el) => el.addEventListener("input", calcAll));

// ---------- copy ----------
document.addEventListener("click", (e) => {
  const b = e.target.closest(".copy"); if (!b) return;
  const pre = $(b.dataset.copy); const txt = pre.dataset.raw || pre.textContent;
  const done = () => { b.textContent = "Tersalin"; setTimeout(() => (b.textContent = "Salin"), 1400); };
  try { navigator.clipboard.writeText(txt).then(done, () => selectPre(pre, b)); } catch (err) { selectPre(pre, b); }
});
function selectPre(pre, b){ const r = document.createRange(); r.selectNodeContents(pre); const s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = "Tekan Ctrl+C"; setTimeout(() => (b.textContent = "Salin"), 2000); }

// ---------- weeks ----------
$("weeks").innerHTML = WEEKS.map((w) => `<div class="wk${w.k === "ex" ? " exam" : ""}"><div class="top"><span class="no">${w.n}</span><span class="tag ${w.k}">${w.k === "sch" ? "Schematic" : w.k === "v" ? "Verilog" : "Ujian"}</span></div><p>${w.t}</p>${w.m.length ? `<div class="mods">${w.m.map((m) => `<code>${m}</code>`).join("")}</div>` : ""}</div>`).join("");

// ---------- modules ----------
const ml = $("modList");
ml.innerHTML = MODS.map((m, i) => `<button type="button" role="tab" aria-selected="${i === 0}" data-i="${i}"><b>${m.name}</b><span>${m.week}</span></button>`).join("");
function showMod(i){ const m = MODS[i]; $("modDesc").textContent = m.desc; setCode("modSrc", m.src); ml.querySelectorAll("button").forEach((b) => b.setAttribute("aria-selected", b.dataset.i == i)); }
ml.addEventListener("click", (e) => { const b = e.target.closest("button"); if (b) showMod(+b.dataset.i); });
showMod(0);
setCode("qsfCode", QSF);

// ---------- hero 7-segment ----------
const SEGMAP = [0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07,0x7F,0x6F];
const SEGPOLY = { a:"10,4 46,4 52,10 46,16 10,16 4,10", b:"50,14 56,8 62,14 62,58 56,64 50,58", c:"50,74 56,68 62,74 62,118 56,124 50,118", d:"10,116 46,116 52,122 46,128 10,128 4,122", e:"0,74 6,68 12,74 12,118 6,124 0,118", f:"0,14 6,8 12,14 12,58 6,64 0,58", g:"10,60 46,60 52,66 46,72 10,72 4,66" };
function renderSeg(digits, colon){
  const on = css("--seg-on"), off = css("--seg-off"); let g = "";
  digits.forEach((d, i) => { const x = 18 + i * 92 + (i >= 2 ? 28 : 0), y = 10; const pat = SEGMAP[d];
    "abcdefg".split("").forEach((s, k) => { const lit = (pat >> k) & 1; g += `<polygon transform="translate(${x},${y})" points="${SEGPOLY[s]}" fill="${lit ? on : off}"${lit ? ' style="filter:drop-shadow(0 0 4px ' + on + ')"' : ""}/>`; }); });
  const c = colon ? on : off; g += `<rect x="196" y="48" width="9" height="9" fill="${c}"/><rect x="196" y="88" width="9" height="9" fill="${c}"/>`;
  $("heroSeg").innerHTML = g;
}
let secs = 37; renderSeg([0,0,3,7], true);
const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
if (!reduce) setInterval(() => { secs = (secs + 1) % 3600; const m = Math.floor(secs / 60), s = secs % 60; renderSeg([Math.floor(m / 10), m % 10, Math.floor(s / 10), s % 10], secs % 2 === 0); }, 1000);
window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { calcAll(); });

tickUnits(); calcAll();
</script>

